#!/usr/bin/env python
"""Thin CLI wrapper so ig-scrape works without an editable install."""

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "src"))

from ig_scrape.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())